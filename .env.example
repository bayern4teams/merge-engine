# =============================================================================
# merge-engine environment variables
# =============================================================================
# Copy this file to .env (gitignored) and fill in real values. Every variable
# the app actually reads is listed here — this file exists specifically so a
# fresh clone on any machine knows what to set (Part 1.6.C).
#
#   cp .env.example .env      # then edit .env
#
# scripts/bootstrap.py does this copy automatically if .env doesn't exist yet.
# =============================================================================

# ── LLM (required) ───────────────────────────────────────────────────────────
# Resolved into config/config.yaml's llm.api_key via ${LLM_API_KEY}. The
# provider/base_url/model live in config.yaml (or the Settings page's
# platform overrides, Part 1.6.A) — this is only the credential.
LLM_API_KEY=

# ── Langfuse tracing (optional) ──────────────────────────────────────────────
# Leave unset to run untraced — the pipeline degrades gracefully, it does not
# fail. To enable: start the self-hosted stack
# (docker compose -f docker/langfuse-compose.yml --env-file docker/langfuse.env up -d)
# then copy the bootstrapped project's keys here (see docker/langfuse.env.example).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ── Embeddings + reranker (optional — retrieve-then-rerank, report §2.22) ────
# Resolved into config/config.yaml's embedding.api_key / reranker.api_key.
# Same vLLM deployment key on both endpoints today; separate vars so they can
# rotate independently. Leave unset to leave the (not-yet-wired) P22 tier
# unconfigured — nothing in the current pipeline reads them.
EMBEDDING_API_KEY=
RERANKER_API_KEY=

# ── Rarely needed overrides ──────────────────────────────────────────────────
# Where recent-connection history is persisted. Only set this to point tests
# or a second local instance at an isolated file; the default is fine
# otherwise.
# MERGE_ENGINE_HISTORY_PATH=config/recent_connections.json

# Set to any non-empty value to disable Part 1.5 D.7's cross-run
# resolve_entities cache (logs/spool/_resolve_cache.duckdb) — useful when
# debugging matcher changes, since a stale cache entry would otherwise mask
# them behind a cache hit.
# MERGE_ENGINE_DISABLE_RESOLVE_CACHE=

# ── P21 ER service — live acceptance tier (optional) ─────────────────────────
# tests/part1/test_p21_live.py is env-gated: without MERGE_ENGINE_LIVE_DB=1
# every live test SKIPS, so `check.py all` and CI (no Postgres, no Mongo) stay
# green. Set these only where a throwaway test Postgres (NEVER a shared
# database's `public` schema — each run gets its own merge_engine-adjacent
# schema, created and dropped by the harness) and a local mongod exist. The
# API key the /v1 service itself authenticates with also lives in .env as
# ER_API_KEY (unset means /v1 is disabled — D-51 fail-closed).
# MERGE_ENGINE_LIVE_DB=1
# ER_TEST_PG_HOST=
# ER_TEST_PG_PORT=5432
# ER_TEST_PG_DB=
# ER_TEST_PG_USER=
# ER_TEST_PG_PASSWORD=
*** ER_TEST_MONGO_URI=mongodb://127.0.0.1:27017/enrichment_entities
# ER_API_KEY=
***
# ER_ENRICHMENT_MONGO_URI=
# ER_ENRICHMENT_MONGO_DB=enrichment_entities
