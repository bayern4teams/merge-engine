# =============================================================================
# merge-engine Environment Variables Example
# =============================================================================
# Copy this file to .env and fill in the actual values:
#   cp .env.example .env
#
# OR set these as system environment variables / in your deployment platform.
# =============================================================================

# ── Origin: CRM (PostgreSQL) ───────────────────────────────────────────────
CRM_DB_HOST=localhost
CRM_DB_PORT=5432
CRM_DB_USER=crm_user
CRM_DB_PASSWORD=change_me
CRM_DB_NAME=crm

# ── Origin: HR System (MongoDB) ───────────────────────────────────────────
HR_MONGO_URI=mongodb://localhost:27017/hr_system

# ── Origin: Legacy (PostgreSQL) ───────────────────────────────────────────
LEGACY_DB_HOST=localhost
LEGACY_DB_PORT=5432
LEGACY_DB_USER=legacy_user
LEGACY_DB_PASSWORD=change_me
LEGACY_DB_NAME=legacy

# ── Destination: Databricks ───────────────────────────────────────────────
DATABRICKS_HOST=xxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxx
DATABRICKS_TOKEN=dapiXXXXX

# ── LLM: OpenAI ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-XXXXX
OPENAI_BASE_URL=  # Optional: for Azure or custom endpoints