# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environments
.venv*/
.tmp/
venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables
.env
.env.*
!.env.example

# Secrets & sensitive config
config/

# Logs
logs/
*.log

# Real seed-data dumps for the sample origin/destination containers — these
# are multi-GB SQL files (sample_databases/origin2_sample/Experience_modified.sql
# alone is 3.4GB), not source. Never belongs in git; distribute separately if
# needed (Git LFS, object storage, etc).
sample_databases/

# Data & fixtures (large files)
# NOT a blanket `*.json` — that silently blocked package.json/package-lock.json/
# tsconfig.json under src/ui/frontend/ from ever being tracked, meaning a fresh
# clone had no way to `npm install` (see TECHNICAL_README.md §18.1). Scope json
# ignores to the specific generated/transient files, not the whole repo.
data/
# NOT a blanket `*.csv` either: it silently untracked
# tests/eval/pagila_staff.csv, so load_staff() fell back to a 2-row stub and
# `check.py eval` hung forever on the degenerate record set. `data/` and
# `backup/` already cover the large dumps this was reaching for.
# (`!tests/fixtures/` used to sit here and was a no-op -- un-ignoring a
#  directory cannot re-include files a `*.csv` rule already matched.)
# Generated verification/test-run output, not source
docs/verification/*.json
tests/integration/test_*_report.json
tests/integration/test_report.json
# Transient import-progress state for the sample-DB seed scripts
**/.import_progress.json

# OS
.DS_Store
Thumbs.db

# pytest
.pytest_cache/
coverage.xml
htmlcov/
.tox/

# mypy
.mypy_cache/

# Ruff
.ruff_cache/

# Docker
*.pid
docker/langfuse.env

# Gradio cache
.gradio/

# Jupyter
.ipynb_checkpoints

# Temporary files
tmp/
temp/
*.tmp

# Langgraph
.langgraph_api/

# Tool-generated caches/logs, not source
.agents/
.playwright-mcp/
.tokensave/
.claude/settings.local.json

# keep graph outputs, skip heavy/local-only files
graphify-out/cache/            # optional: commit for shared extraction speed, skip to keep repo small
graphify-out/manifest.json     # mtime-based, invalid after git clone — always gitignore this
graphify-out/cost.json         # local token tracking, not useful to share
# Per-run scratch: DuckDB spools and scale-test measurements are local only
logs/spool/
logs/scale/

# BP-B4 gate outcome: a timestamped measurement from one specific slow-test
# run (tests/eval/test_matcher_recall.py -m slow), not a fixture — the
# measured result it records is already written up in prose in ADR 0004's
# addendum, which is the durable source of truth. Regenerate, don't commit.
tests/eval/last_gate.json

# Saved run profiles hold no secrets (passwords are stripped on save), but
# they name a specific person's databases, so they stay local by default.
config/profiles/

# Node / frontend
node_modules/
*.tsbuildinfo

# Per-branch git worktrees (each a full checkout for a parallel agent) —
# nested under the repo root so they never touch a parent folder, but they
# are not repo content and must never be tracked or committed.
.worktrees/

# diagnosis files
*.png
V3/

# diagnosis
Bugs/
scripts/ground_truth/cache_zi_company.tsv
scripts/ground_truth/cache_diffbot/
backup/
