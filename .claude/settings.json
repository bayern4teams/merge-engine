{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/refresh_graphs.py --session-start",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/refresh_graphs.py --session-start",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
