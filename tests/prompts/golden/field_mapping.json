          {"name": "_source_ids", "type": "TEXT"}
        ],
        "fields": [
          {"name": "cd", "type": "str", "sample_values": ["gold", "silver", "bronze"]}
        ]
      },
      "expected": {
        "cd": {"action": "map", "dest_column": "membership_tier"}
      }
    },
    {
      "id": "fm-07-numeric-vs-text-disambiguation",
      "input": {
        "entity_type": "company",
        "dest_table": "companies",
        "destination_schema": [
          {"name": "id", "type": "BIGINT"},
          {"name": "name", "type": "TEXT"},
          {"name": "employee_count", "type": "INTEGER"},
          {"name": "industry", "type": "TEXT"},
          {"name": "_source_ids", "type": "TEXT"}
        ],
        "fields": [
          {"name": "org", "type": "str", "sample_values": ["Acme Corp", "Globex GmbH"]},
          {"name": "org_size", "type": "int", "sample_values": [45, 230]}
        ]
      },
      "expected": {
        "org": {"action": "map", "dest_column": "name"},
        "org_size": {"action": "map", "dest_column": "employee_count"}
      }
    },
    {
      "id": "fm-08-genuinely-unmappable-new-column",
      "input": {
        "entity_type": "person",
        "dest_table": "people",
        "destination_schema": [
          {"name": "id", "type": "BIGINT"},
          {"name": "name", "type": "TEXT"},
          {"name": "email", "type": "TEXT"},
          {"name": "phone", "type": "TEXT"},
          {"name": "_source_ids", "type": "TEXT"}
        ],
        "fields": [
          {"name": "linkedin_url", "type": "str", "sample_values": ["https://linkedin.com/in/abc", "https://linkedin.com/in/xyz"]}
        ]
      },
      "expected": {
        "linkedin_url": {"action": "new_column"}
      }
    }
  ]
}
