          {"name": "city", "type": "TEXT"},
          {"name": "founded_year", "type": "INTEGER"},
          {"name": "_source_ids", "type": "TEXT"}
        ],
        "fields": [
          {"name": "co_nm", "type": "str", "sample_values": ["Acme Corp", "Delta LLC"]},
          {"name": "yr_est", "type": "int", "sample_values": [1998, 2010]},
          {"name": "hq_loc", "type": "str", "sample_values": ["Berlin", "Austin"]}
        ]
      },
      "expected": {
        "co_nm": {"action": "map", "dest_column": "name"},
        "yr_est": {"action": "map", "dest_column": "founded_year"},
        "hq_loc": {"action": "map", "dest_column": "city"}
      }
    },
    {
      "id": "fm-06-two-letter-name-sample-values-decide",
      "input": {
        "entity_type": "person",
        "dest_table": "people",
        "destination_schema": [
          {"name": "id", "type": "BIGINT"},
          {"name": "name", "type": "TEXT"},
          {"name": "email", "type": "TEXT"},
          {"name": "phone", "type": "TEXT"},
