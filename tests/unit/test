"""
Tests for src/ui/components/mapping_reviewer.py - Mapping reviewer component.
"""

import pytest
from src.ui.components.mapping_reviewer import render_mapping_reviewer, create_mapping_reviewer_block


class TestRenderMappingReviewer:
    """Tests for render_mapping_reviewer() function."""

    def test_no_unmapped_fields_no_schema_changes(self):
        """Should show success message when all fields mapped."""
        result = render_mapping_reviewer([], [])
        html = result.value
        assert "All fields have been mapped successfully" in html
        assert "No schema changes needed" in html

    def test_unmapped_fields(self):
        """Should display unmapped fields in table."""
        unmapped = [
            {"entity_type": "person", "source_field": "middle_name", "reason": "No matching column"},
            {"entity_type": "company", "source_field": "tax_id", "reason": "New field"},
        ]
        result = render_mapping_reviewer(unmapped, [])
        html = result.value
        assert "2 field(s) require mapping" in html
        assert "person" in html
        assert "middle_name" in html
        assert "company" in html
        assert "tax_id" in html
        assert "No matching column" in html

    def test_missing_entity_type_in_unmapped(self):
        """Should handle missing entity_type gracefully."""
        unmapped = [{"source_field": "unknown_field"}]
        result = render_mapping_reviewer(unmapped, [])
        html = result.value
        assert "?" in html  # Default for missing entity_type

    def test_missing_source_field_in_unmapped(self):
        """Should handle missing source_field gracefully."""
        unmapped = [{"entity_type": "person"}]
        result = render_mapping_reviewer(unmapped, [])
        html = result.value
        assert "?" in html  # Default for missing source_field

    def test_schema_changes_displayed(self):
        """Should display proposed schema changes."""
        changes = [
            {"table": "dim_person", "column": "department", "data_type": "STRING"},
            {"table": "dim_company", "column": "tax_id", "data_type": "VARCHAR(20)"},
        ]
        result = render_mapping_reviewer([], changes)
        html = result.value
        assert "2 new column(s) to be added" in html
        assert "dim_person" in html
        assert "department" in html
        assert "STRING" in html
        assert "dim_company" in html
        assert "tax_id" in html

    def test_missing_fields_in_schema_changes(self):
        """Should handle missing fields in schema changes."""
        changes = [{}]  # Empty change dict
        result = render_mapping_reviewer([], changes)
        html = result.value
        assert "?" in html  # Defaults for missing fields

    def test_both_unmapped_and_schema_changes(self):
        """Should display both sections together."""
        unmapped = [{"entity_type": "person", "source_field": "phone"}]
        changes = [{"table": "dim_person", "column": "phone", "data_type": "STRING"}]
        result = render_mapping_reviewer(unmapped, changes)
        html = result.value
        assert "Field Mapping Review" in html
        assert "Unmapped Fields" in html
        assert "Proposed Schema Changes" in html
        assert "1 field(s) require mapping" in html
        assert "1 new column(s) to be added" in html

    def test_returns_html_component(self):
        """Should return a gr.HTML component."""
        result = render_mapping_reviewer([], [])
        assert hasattr(result, "value")
        assert isinstance(result.value, str)

    def test_html_contains_title(self):
        """HTML should contain review title."""
        result = render_mapping_reviewer([], [])
        assert "Field Mapping Review" in result.value

    def test_html_has_table_structure(self):
        """HTML should contain table structure for unmapped fields."""
        unmapped = [{"entity_type": "test", "source_field": "col"}]
        result = render_mapping_reviewer(unmapped, [])
        html = result.value
        assert "<table" in html
        assert "</table>" in html
        assert "<tr>" in html
        assert "<td>" in html

    def test_html_has_select_dropdown(self):
        """HTML should contain select dropdown for unmapped field actions."""
        unmapped = [{"entity_type": "test", "source_field": "col"}]
        result = render_mapping_reviewer(unmapped, [])
        html = result.value
        assert "<select>" in html
        assert "Map to existing column" in html
        assert "Discard" in html

    def test_html_has_add_confirmation(self):
        """HTML should contain add confirmation for schema changes."""
        changes = [{"table": "t", "column": "c", "data_type": "STRING"}]
        result = render_mapping_reviewer([], changes)
        html = result.value
        assert "Add" in html

    def test_empty_unmapped_list(self):
        """Empty unmapped list should not show error."""
        result = render_mapping_reviewer([], [])
        assert "All fields have been mapped" in result.value

    def test_empty_schema_changes_list(self):
        """Empty schema changes list should not show error."""
        result = render_mapping_reviewer([], [])
        assert "No schema changes needed" in result.value


