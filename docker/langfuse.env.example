# =============================================================================
# Self-hosted Langfuse stack secrets (docker/langfuse-compose.yml)
# =============================================================================
# Copy to docker/langfuse.env (gitignored) and fill in generated values:
#
#   cp docker/langfuse.env.example docker/langfuse.env
#   # then replace every <generate> below, e.g.:
#   openssl rand -hex 32
#
# These secrets only guard a container reachable from this machine — they are
# not a production deployment's secrets. Regenerate any of them any time.
# =============================================================================

# ── Core secrets (langfuse-web / langfuse-worker) ────────────────────────────
SALT=<generate: openssl rand -hex 32>
ENCRYPTION_KEY=<generate: openssl rand -hex 32>
NEXTAUTH_SECRET=<generate: openssl rand -hex 32>
REDIS_AUTH=<generate: openssl rand -hex 16>
CLICKHOUSE_PASSWORD=<generate: openssl rand -hex 16>
MINIO_ROOT_PASSWORD=<generate: openssl rand -hex 16>
POSTGRES_PASSWORD=<generate: openssl rand -hex 16>
TELEMETRY_ENABLED=false

# ── Headless bootstrap: auto-create org / project / admin user / API keys ───
# On first boot, langfuse-web creates all of these — no manual signup needed.
# Copy LANGFUSE_INIT_PROJECT_PUBLIC_KEY / _SECRET_KEY into your .env as
# LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY once the stack is up.
LANGFUSE_INIT_ORG_ID=merge-engine
LANGFUSE_INIT_ORG_NAME=merge-engine
LANGFUSE_INIT_PROJECT_ID=merge-engine
LANGFUSE_INIT_PROJECT_NAME=merge-engine
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=<generate: openssl rand -hex 16, prefix pk->
LANGFUSE_INIT_PROJECT_SECRET_KEY=<generate: openssl rand -hex 16, prefix sk->
LANGFUSE_INIT_USER_EMAIL=admin@merge-engine.local
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=<generate: openssl rand -hex 16>
